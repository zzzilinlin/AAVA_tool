modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libxcrypt", "pkg-config", "qhull", "tcl", "tk"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AAVA Pipeline"

[[workflows.workflow]]
name = "AAVA Pipeline"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "kedro run 2>&1 || echo \"Pipeline completed with status: $?\""

[workflows.workflow.metadata]
outputType = "console"
